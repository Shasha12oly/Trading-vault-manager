# Discord Bot Configuration
# Copy this file to .env and fill in your actual values

# Your Discord Bot Token (required)
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# The ID of your Support/Staff role (required)
# Right-click the role in Discord > Copy ID
SUPPORT_ROLE_ID=123456789012345678

# The ID of the category where tickets will be created (required)
# Right-click the category in Discord > Copy ID
TICKET_CATEGORY_ID=123456789012345678

# The ID of the channel where ticket transcripts will be posted (optional)
# Set to 0 or leave empty to disable transcript logging
LOG_CHANNEL_ID=123456789012345678

# Image URLs for embed styling (optional)
THUMBNAIL_URL=https://example.com/thumbnail.png
BANNER_URL=https://example.com/banner.png

# Banner visibility settings for different message types (optional)
# Set to "true" to show banners, "false" to hide them for each type
BANNER_TICKET_CREATION=true
BANNER_PURCHASE_CREATION=true
BANNER_TICKET_CONTROLS=true
BANNER_PAYMENT_INFO=true
BANNER_RATING=true
BANNER_VOUCH=true
BANNER_CONFIG=true
BANNER_PANEL=true
BANNER_GENERAL=true

# Guild ID for faster command syncing (optional)
# Set this to your server ID for instant command updates during development
SYNC_GUILD_ID=0

# Payment Configuration
INR_QR_URL=https://example.com/inr_qr.png
LTC_QR_URL=https://example.com/ltc_qr.png
INR_WALLET_ADDRESS=your_inr_wallet_address
LTC_WALLET_ADDRESS=your_ltc_wallet_address

# Rating Channel Configuration
RATING_CHANNEL_ID=123456789012345678

# Vouch Channel Configuration
VOUCH_CHANNEL_ID=123456789012345678
